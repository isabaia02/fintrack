PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fintrack
# Mínimo de 32 caracteres aleatórios (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1h
# Origens permitidas, separadas por vírgula ("*" não é aceito; obrigatório com NODE_ENV=production)
CORS_ORIGIN=http://localhost:5173
# Tentativas de login que falham por IP a cada 15 min e cadastros por IP por hora
LOGIN_RATE_LIMIT_MAX=10
CADASTRO_RATE_LIMIT_MAX=20
# Atrás de proxy/balanceador: quantos proxies confiar para ler o IP real (rate limit).
# Use o número de proxies (ex.: 1), não "true": com "true" o cliente forja o IP pelo X-Forwarded-For
# e escapa do rate limit.
# TRUST_PROXY=1
# Opcional: dicas extras por IA em /api/saude-financeira (sem a chave, só dicas por regras)
# ANTHROPIC_API_KEY=
# IA_MODELO=claude-haiku-5-5
